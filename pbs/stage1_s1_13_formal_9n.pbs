#!/bin/bash
#PBS -q debug-g
#PBS -l select=1
#PBS -l walltime=00:30:00
#PBS -W group_list=xg24i002
#PBS -r y
#PBS -J 0-8
#PBS -N fsbdd-s1-13-9n

set -eEuo pipefail
source "${PROJECT_ROOT:-/work/xg24i002/x10041/fsbdd}/pbs/lib/record_experiment_failure.sh"
install_experiment_failure_traps

: "${PROJECT_ROOT:?PROJECT_ROOT is required}"
: "${MAIN_ROOT:=/work/xg24i002/x10041/fsbdd}"
: "${HF_HOME:=/work/xg24i002/x10041/hf_home}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${RESOLVED_CONFIG:?RESOLVED_CONFIG is required}"
: "${CONFIG_SHA256:?CONFIG_SHA256 is required}"
: "${ASSET_ROOT:?ASSET_ROOT is required}"
: "${ASSET_MARKER_SHA256:?ASSET_MARKER_SHA256 is required}"
: "${GATE_CONTRACT:?GATE_CONTRACT is required}"
: "${GATE_CONTRACT_SHA256:?GATE_CONTRACT_SHA256 is required}"
: "${SHARED_ROOT:?SHARED_ROOT is required}"
: "${RESULT_ROOT:?RESULT_ROOT is required}"
: "${EVIDENCE_ROOT:?EVIDENCE_ROOT is required}"
: "${SUBMISSION_UTC:?SUBMISSION_UTC is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${SUBMISSION_MARKER_SHA256:?SUBMISSION_MARKER_SHA256 is required}"

PYTHON="$MAIN_ROOT/.venv/bin/python"
ROLE_INDEX="${PBS_ARRAY_INDEX:?PBS_ARRAY_INDEX is required}"
module load nv-hpcx/25.9
export PYTHONPATH="$PROJECT_ROOT/src"
if [[ "$(git -C "$PROJECT_ROOT" rev-parse HEAD)" != "$EXPECTED_COMMIT" ]] || \
   [[ -n "$(git -C "$PROJECT_ROOT" status --porcelain)" ]]; then
  echo "formal clean worktree identity mismatch" >&2
  exit 65
fi
if [[ "$(sha256sum "$RESOLVED_CONFIG" | awk '{print $1}')" != "$CONFIG_SHA256" ]] || \
   [[ "$(sha256sum "$ASSET_ROOT/complete.json" | awk '{print $1}')" != "$ASSET_MARKER_SHA256" ]] || \
   [[ "$(sha256sum "$GATE_CONTRACT" | awk '{print $1}')" != "$GATE_CONTRACT_SHA256" ]]; then
  echo "formal config, asset, or gate-contract identity mismatch" >&2
  exit 65
fi
"$PYTHON" -m fsbdd.auxiliary.stage1.submit validate-nine \
  --shared-root "$SHARED_ROOT" --result-root "$RESULT_ROOT" \
  --evidence-root "$EVIDENCE_ROOT" --run-id "$RUN_ID" \
  --submission-utc "$SUBMISSION_UTC" --code-commit "$EXPECTED_COMMIT" \
  --config-sha256 "$CONFIG_SHA256" \
  --asset-marker-sha256 "$ASSET_MARKER_SHA256" \
  --gate-contract-sha256 "$GATE_CONTRACT_SHA256" \
  --submission-marker-sha256 "$SUBMISSION_MARKER_SHA256" > /dev/null

FSBDD_FAILURE_OUTPUT_ROOT="$RESULT_ROOT"
mkdir -p "$RESULT_ROOT"/{roles,logs,env,stdout,stderr}
cd "$PROJECT_ROOT"
export OMP_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1
hostname > "$RESULT_ROOT/env/role-${ROLE_INDEX}-hostname.txt"
cp "$PBS_NODEFILE" "$RESULT_ROOT/env/role-${ROLE_INDEX}-nodefile.txt"
qstat -f "$PBS_JOBID" > "$RESULT_ROOT/env/role-${ROLE_INDEX}-qstat.txt"
module -t list > "$RESULT_ROOT/env/role-${ROLE_INDEX}-modules.txt" 2>&1
findmnt -T "$SHARED_ROOT" > "$RESULT_ROOT/env/role-${ROLE_INDEX}-findmnt.txt"
if [[ "$ROLE_INDEX" -eq 8 ]]; then
  cp "$PROJECT_ROOT/pbs/stage1_s1_13_formal_9n.pbs" "$RESULT_ROOT/env/formal-pbs-script.pbs"
fi
ROLE_QTIME_RAW="$(awk -F' = ' '/^[[:space:]]*qtime =/{print $2}' "$RESULT_ROOT/env/role-${ROLE_INDEX}-qstat.txt")"
export PBS_QTIME_UTC="$(date -u -d "$ROLE_QTIME_RAW JST" '+%Y-%m-%dT%H:%M:%SZ')"

if [[ "$ROLE_INDEX" -lt 8 ]]; then
  export CUDA_VISIBLE_DEVICES=0
  "$PYTHON" -m fsbdd.auxiliary.stage1.close learner \
    --shared-root "$SHARED_ROOT" --result-root "$RESULT_ROOT" --run-id "$RUN_ID" \
    --config-path "$RESOLVED_CONFIG" --config-sha256 "$CONFIG_SHA256" \
    --asset-marker-sha256 "$ASSET_MARKER_SHA256" --hub-cache "$HF_HOME/hub" \
    --gate-contract "$GATE_CONTRACT" \
    --gate-contract-sha256 "$GATE_CONTRACT_SHA256" \
    --learner-index "$ROLE_INDEX" --timeout-seconds 1200 \
    > "$RESULT_ROOT/stdout/role-${ROLE_INDEX}.log" \
    2> "$RESULT_ROOT/stderr/role-${ROLE_INDEX}.log"
  exit 0
fi

export CUDA_VISIBLE_DEVICES=""
"$PYTHON" -m pytest -q tests/stage1 \
  > "$RESULT_ROOT/stdout/pytest.log" 2> "$RESULT_ROOT/stderr/pytest.log"
"$PYTHON" -m fsbdd.cli requirements \
  plans/FS_DILOCO_CODEX_EXECUTION_PLAN/loops/stage1/S1-13.md \
  reports/stage1/S1-13-requirement-matrix.csv \
  > "$RESULT_ROOT/requirements.json" 2> "$RESULT_ROOT/stderr/requirements.log"
"$PYTHON" -m fsbdd.auxiliary.stage1.close syncer \
  --shared-root "$SHARED_ROOT" --result-root "$RESULT_ROOT" --run-id "$RUN_ID" \
  --config-path "$RESOLVED_CONFIG" --config-sha256 "$CONFIG_SHA256" \
  --asset-marker-sha256 "$ASSET_MARKER_SHA256" --timeout-seconds 1200 \
  --gate-contract "$GATE_CONTRACT" \
  --gate-contract-sha256 "$GATE_CONTRACT_SHA256" \
  > "$RESULT_ROOT/stdout/role-${ROLE_INDEX}.log" \
  2> "$RESULT_ROOT/stderr/role-${ROLE_INDEX}.log"

QTIME_RAW="$(awk -F' = ' '/^[[:space:]]*qtime =/{print $2}' "$RESULT_ROOT/env/role-${ROLE_INDEX}-qstat.txt")"
QTIME_UTC="$(date -u -d "$QTIME_RAW JST" '+%Y-%m-%dT%H:%M:%SZ')"
"$PYTHON" -m fsbdd.auxiliary.stage1.package \
  --project-root "$PROJECT_ROOT" --evidence-root "$EVIDENCE_ROOT" \
  --result-root "$RESULT_ROOT" --shared-root "$SHARED_ROOT" --asset-root "$ASSET_ROOT" \
  --config "$RESOLVED_CONFIG" --requirements "$RESULT_ROOT/requirements.json" \
  --gate-contract "$GATE_CONTRACT" \
  --submission-marker "$RESULT_ROOT/submission-root.json" \
  --env-root "$RESULT_ROOT/env" --stdout-root "$RESULT_ROOT/stdout" \
  --stderr-root "$RESULT_ROOT/stderr" --run-id "$RUN_ID" \
  --repository https://github.com/UnbearableFate/fsbdd.git \
  --branch codex/S1-13-stage1-close-9n --commit "$EXPECTED_COMMIT" \
  --research-sha256 2c0db3148110da10ea62f445c189d2d53b405527d8da264b9af9817f5ca9d835 \
  --spec-sha256 1ea71fb6e34fef0d7b5558d8e7999dfdedeb82957f4331afcf6f80279d1f5a7d \
  --skill-repository https://github.com/UnbearableFate/miyabi-development \
  --skill-commit c3ddfa47cadfd9132edf939d359b90b28ab5f8ed \
  --initial-hostname miyabi-g1 --job-id "$PBS_JOBID" --queue debug-g \
  --timestamp-utc "$SUBMISSION_UTC" --scheduler-qtime-utc "$QTIME_UTC" \
  --time-source submission_utc \
  > "$RESULT_ROOT/package.json" 2> "$RESULT_ROOT/package.err"
