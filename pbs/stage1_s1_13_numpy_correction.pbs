#!/bin/bash
#PBS -q debug-g
#PBS -l select=1
#PBS -l walltime=00:10:00
#PBS -W group_list=xg24i002
#PBS -N fsbdd-s1-13-capacity

set -eEuo pipefail
source "${PROJECT_ROOT:-/work/xg24i002/x10041/fsbdd}/pbs/lib/record_experiment_failure.sh"
install_experiment_failure_traps

: "${PROJECT_ROOT:?PROJECT_ROOT is required}"
: "${MAIN_ROOT:=/work/xg24i002/x10041/fsbdd}"
: "${CAPACITY_CONTRACT:?CAPACITY_CONTRACT is required}"
: "${SHARED_ROOT:?SHARED_ROOT is required}"
: "${RESULT_ROOT:?RESULT_ROOT is required}"
: "${RUN_ID:?RUN_ID is required}"

PYTHON="$MAIN_ROOT/.venv/bin/python"
module load nv-hpcx/25.9
if [[ -e "$SHARED_ROOT" || -e "$RESULT_ROOT" ]]; then
  echo "refusing to reuse capacity-preflight roots" >&2
  exit 73
fi
mkdir -p "$RESULT_ROOT"/{analysis,env,stdout,stderr}
FSBDD_FAILURE_OUTPUT_ROOT="$RESULT_ROOT"
cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT/src"
export OMP_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1
export CUDA_VISIBLE_DEVICES=-1
export FSBDD_CODE_COMMIT
FSBDD_CODE_COMMIT="$(git rev-parse HEAD)"

hostname > "$RESULT_ROOT/env/hostname.txt"
git rev-parse HEAD > "$RESULT_ROOT/env/commit.txt"
git status --short > "$RESULT_ROOT/env/worktree-status.txt"
git diff --binary > "$RESULT_ROOT/env/worktree.patch"
qstat -f "$PBS_JOBID" > "$RESULT_ROOT/env/qstat.txt"
module -t list > "$RESULT_ROOT/env/modules.txt" 2>&1
findmnt -T "$(dirname "$SHARED_ROOT")" > "$RESULT_ROOT/env/findmnt.txt"
cp "$PROJECT_ROOT/pbs/stage1_s1_13_numpy_correction.pbs" \
  "$RESULT_ROOT/env/pbs-script.pbs"
cp "$CAPACITY_CONTRACT" "$RESULT_ROOT/env/capacity-contract.json"

# Sequential ceilings total 420 seconds and leave 180 seconds of PBS walltime
# for setup and automatic failure capture.
timeout --signal=TERM --kill-after=15s 120s \
  "$PYTHON" -m pytest -vv -o faulthandler_timeout=60 --durations=20 \
  tests/stage1 \
  > "$RESULT_ROOT/stdout/pytest.log" 2> "$RESULT_ROOT/stderr/pytest.log"
timeout --signal=TERM --kill-after=15s 300s \
  "$PYTHON" -m fsbdd.auxiliary.stage1.capacity \
  --shared-root "$SHARED_ROOT" \
  --output "$RESULT_ROOT/analysis/capacity-preflight.json" \
  --run-id "$RUN_ID" --contract "$RESULT_ROOT/env/capacity-contract.json" \
  > "$RESULT_ROOT/stdout/capacity.log" \
  2> "$RESULT_ROOT/stderr/capacity.log"
jq -e '.status == "pass" and (.checks | all)' \
  "$RESULT_ROOT/analysis/capacity-preflight.json" >/dev/null
