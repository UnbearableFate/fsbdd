#!/bin/bash
#PBS -q debug-g
#PBS -l select=5
#PBS -l walltime=00:30:00
#PBS -W group_list=xg24i002
#PBS -N fsbdd-s1-13-long-smoke

set -eEuo pipefail
source "${PROJECT_ROOT:-/work/xg24i002/x10041/fsbdd}/pbs/lib/record_experiment_failure.sh"
install_experiment_failure_traps

: "${PROJECT_ROOT:?PROJECT_ROOT is required}"
: "${MAIN_ROOT:=/work/xg24i002/x10041/fsbdd}"
: "${HF_HOME:=/work/xg24i002/x10041/hf_home}"
: "${RESOLVED_CONFIG:?RESOLVED_CONFIG is required}"
: "${GATE_CONTRACT:?GATE_CONTRACT is required}"
: "${SHARED_ROOT:?SHARED_ROOT is required}"
: "${RESULT_ROOT:?RESULT_ROOT is required}"
: "${RUN_ID:?RUN_ID is required}"

PYTHON="$MAIN_ROOT/.venv/bin/python"
module load nv-hpcx/25.9
if [[ -e "$SHARED_ROOT" || -e "$RESULT_ROOT" ]]; then
  echo "refusing to reuse long-smoke roots" >&2
  exit 73
fi
mkdir "$SHARED_ROOT"
mkdir -p "$RESULT_ROOT"/{roles,logs,analysis,env,stdout,stderr}
FSBDD_FAILURE_OUTPUT_ROOT="$RESULT_ROOT"
cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT/src"
export OMP_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1

sort -u "$PBS_NODEFILE" > "$RESULT_ROOT/env/compute-hosts.txt"
if [[ "$(wc -l < "$RESULT_ROOT/env/compute-hosts.txt")" -ne 5 ]]; then
  echo "long-smoke requires five distinct compute hosts" >&2
  exit 66
fi
cp "$PBS_NODEFILE" "$RESULT_ROOT/env/pbs-nodefile.txt"
qstat -f "$PBS_JOBID" > "$RESULT_ROOT/env/qstat.txt"
module -t list > "$RESULT_ROOT/env/modules.txt" 2>&1
findmnt -T "$SHARED_ROOT" > "$RESULT_ROOT/env/findmnt.txt"
cp "$PROJECT_ROOT/pbs/stage1_s1_13_long_smoke.pbs" "$RESULT_ROOT/env/pbs-script.pbs"
cp "$RESOLVED_CONFIG" "$RESULT_ROOT/env/resolved-config.json"
cp "$GATE_CONTRACT" "$RESULT_ROOT/env/gate-contract.json"
RESOLVED_CONFIG="$RESULT_ROOT/env/resolved-config.json"
GATE_CONTRACT="$RESULT_ROOT/env/gate-contract.json"
CONFIG_SHA256="$(sha256sum "$RESOLVED_CONFIG" | awk '{print $1}')"
GATE_CONTRACT_SHA256="$(sha256sum "$GATE_CONTRACT" | awk '{print $1}')"
ASSET_MARKER_SHA256="$(jq -er '.resolved_runtime_fields.asset_marker_sha256' \
  "$RESOLVED_CONFIG")"
git rev-parse HEAD > "$RESULT_ROOT/env/commit.txt"
git status --short > "$RESULT_ROOT/env/worktree-status.txt"
git diff --binary > "$RESULT_ROOT/env/worktree.patch"
ROLE_QTIME_RAW="$(awk -F' = ' '/^[[:space:]]*qtime =/{print $2}' "$RESULT_ROOT/env/qstat.txt")"
export PBS_QTIME_UTC="$(date -u -d "$ROLE_QTIME_RAW JST" '+%Y-%m-%dT%H:%M:%SZ')"
# Sequential supervisor ceilings total 1590 seconds (60 + 120 + 1350 + 60).
# One terminal kill grace adds at most 15 seconds, leaving at least 195 seconds
# of the 1800-second PBS walltime for setup and failure-evidence finalization.
timeout --signal=TERM --kill-after=15s 60s \
  mpirun -np 5 --map-by ppr:1:node --hostfile "$PBS_NODEFILE" nvidia-smi -L \
  > "$RESULT_ROOT/env/nvidia-smi-all-nodes.txt" 2>&1

timeout --signal=TERM --kill-after=15s 120s \
  "$PYTHON" -m pytest -vv --durations=20 -o faulthandler_timeout=60 tests/stage1 \
  > "$RESULT_ROOT/stdout/pytest.log" 2> "$RESULT_ROOT/stderr/pytest.log"
timeout --signal=TERM --kill-after=15s 1350s \
  mpirun -np 5 --map-by ppr:1:node --hostfile "$PBS_NODEFILE" \
  /usr/bin/env PYTHONPATH="$PYTHONPATH" OMP_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false \
  HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 \
  "$PYTHON" -m fsbdd.auxiliary.stage1.close mpi \
  --shared-root "$SHARED_ROOT" --result-root "$RESULT_ROOT" --run-id "$RUN_ID" \
  --config-path "$RESOLVED_CONFIG" --config-sha256 "$CONFIG_SHA256" \
  --asset-marker-sha256 "$ASSET_MARKER_SHA256" --hub-cache "$HF_HOME/hub" \
  --gate-contract "$GATE_CONTRACT" \
  --gate-contract-sha256 "$GATE_CONTRACT_SHA256" \
  --non-formal-long-smoke --timeout-seconds 1200 \
  > "$RESULT_ROOT/stdout/mpirun.log" 2> "$RESULT_ROOT/stderr/mpirun.log"

timeout --signal=TERM --kill-after=15s 60s \
  "$PYTHON" -m fsbdd.auxiliary.stage1.gate \
  --result-root "$RESULT_ROOT" --config "$RESOLVED_CONFIG" \
  --gate-contract "$GATE_CONTRACT" --output-root "$RESULT_ROOT/analysis" \
  --non-formal-long-smoke \
  > "$RESULT_ROOT/stdout/gate.log" 2> "$RESULT_ROOT/stderr/gate.log"
if find "$RESULT_ROOT/stderr" -type f -size +0c -print -quit | grep -q .; then
  echo "long-smoke produced non-empty stderr" >&2
  find "$RESULT_ROOT/stderr" -type f -size +0c -print >&2
  exit 1
fi
