#!/bin/bash
#PBS -q regular-g
#PBS -l select=1
#PBS -l walltime=04:00:00
#PBS -W group_list=xg24i002
#PBS -N fsbdd-s1-13-assets

set -eEuo pipefail
trap 'echo "[ERROR] line=$LINENO command=$BASH_COMMAND" >&2' ERR

: "${PROJECT_ROOT:=/work/xg24i002/x10041/fsbdd}"
: "${HF_HOME:=/work/xg24i002/x10041/hf_home}"
: "${OUTPUT_ROOT:=$PROJECT_ROOT/runtime_runs/S1-13/assets-${PBS_JOBID}}"

PYTHON="$PROJECT_ROOT/.venv/bin/python"
HF="$PROJECT_ROOT/.venv/bin/hf"
HUB_CACHE="$HF_HOME/hub"
LOG_ROOT="$PROJECT_ROOT/runtime_runs/S1-13/asset-stage-${PBS_JOBID}"

module load nv-hpcx/25.9
if [[ -e "$OUTPUT_ROOT" || -e "$LOG_ROOT" ]]; then
  echo "refusing to reuse S1-13 asset output" >&2
  exit 73
fi
mkdir -p "$LOG_ROOT"
cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT/src"
export TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=1

"$HF" --version > "$LOG_ROOT/hf-cli-version.txt"
"$HF" download openai-community/gpt2 \
  config.json model.safetensors merges.txt tokenizer.json tokenizer_config.json vocab.json \
  --revision 607a30d783dfa663caf39e06633721c8d4cfcd7e --cache-dir "$HUB_CACHE" --quiet \
  > "$LOG_ROOT/hf-gpt2.txt" 2> "$LOG_ROOT/hf-gpt2.err"
"$HF" download Salesforce/wikitext \
  wikitext-2-raw-v1/train-00000-of-00001.parquet \
  wikitext-2-raw-v1/validation-00000-of-00001.parquet \
  --type dataset --revision b08601e04326c79dfdd32d625aee71d232d685c3 \
  --cache-dir "$HUB_CACHE" --quiet \
  > "$LOG_ROOT/hf-wikitext.txt" 2> "$LOG_ROOT/hf-wikitext.err"
"$HF" download EleutherAI/pythia-160m \
  config.json model.safetensors special_tokens_map.json tokenizer.json tokenizer_config.json \
  --revision 50f5173d932e8e61f858120bcb800b97af589f46 --cache-dir "$HUB_CACHE" --quiet \
  > "$LOG_ROOT/hf-pythia.txt" 2> "$LOG_ROOT/hf-pythia.err"
"$HF" download HuggingFaceFW/fineweb-edu \
  sample/10BT/000_00000.parquet sample/10BT/001_00000.parquet \
  --type dataset --revision 87f09149ef4734204d70ed1d046ddc9ca3f2b8f9 \
  --cache-dir "$HUB_CACHE" --quiet \
  > "$LOG_ROOT/hf-fineweb.txt" 2> "$LOG_ROOT/hf-fineweb.err"

export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1
"$PYTHON" -m fsbdd.auxiliary.stage1.assets prepare \
  --config configs/stage1/s1_13_stage1_close.json \
  --hub-cache "$HUB_CACHE" --output "$OUTPUT_ROOT" \
  --reuse-gpt-train runtime_runs/S1-06/materialized/gpt2-wikitext \
  --reuse-pythia-smoke runtime_runs/S1-06/materialized/pythia160m-fineweb \
  > "$LOG_ROOT/prepare.json" 2> "$LOG_ROOT/prepare.err"

hostname > "$LOG_ROOT/hostname.txt"
qstat -f "$PBS_JOBID" > "$LOG_ROOT/qstat.txt"
sha256sum "$OUTPUT_ROOT/manifest.json" "$OUTPUT_ROOT/complete.json" \
  > "$LOG_ROOT/checksums.txt"
