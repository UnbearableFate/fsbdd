#!/bin/bash
#PBS -q debug-g
#PBS -l select=1
#PBS -l walltime=00:15:00
#PBS -W group_list=xg24i002
#PBS -N fsbdd-s1-09-targeted

set -eEuo pipefail
trap 'echo "[ERROR] line=$LINENO command=$BASH_COMMAND" >&2' ERR

: "${PROJECT_ROOT:=/work/xg24i002/x10041/fsbdd-s100-clean}"
: "${MAIN_ROOT:=/work/xg24i002/x10041/fsbdd}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${MODULE_NAME:=nv-hpcx/25.9}"

PYTHON="$MAIN_ROOT/.venv/bin/python"
RUN_ROOT="$MAIN_ROOT/runtime_runs/S1-09/l1-targeted-${PBS_JOBID}"
CONFIG_SOURCE="configs/stage1/s1_09_syncer_readiness.json"
CONFIG_SHA256="8ff3fe364fca10bb48fe80ebf0bcede63163731e47cc26fc87512b298e3c225d"

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
module load "$MODULE_NAME"
if [[ "$(git -C "$PROJECT_ROOT" rev-parse HEAD)" != "$EXPECTED_COMMIT" ]]; then
  echo "clean worktree commit mismatch" >&2
  exit 65
fi
if [[ -n "$(git -C "$PROJECT_ROOT" status --porcelain)" ]]; then
  echo "targeted worktree is dirty" >&2
  exit 65
fi
if [[ "$(sha256sum "$PROJECT_ROOT/$CONFIG_SOURCE" | awk '{print $1}')" != "$CONFIG_SHA256" ]]; then
  echo "readiness config hash mismatch" >&2
  exit 65
fi
if [[ -e "$RUN_ROOT" ]]; then
  echo "refusing to reuse targeted evidence root: $RUN_ROOT" >&2
  exit 73
fi
mkdir -p "$RUN_ROOT"/{env,stdout,stderr}
cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT/src"
export OMP_NUM_THREADS=1

git rev-parse HEAD > "$RUN_ROOT/env/git-commit.txt"
git status --porcelain > "$RUN_ROOT/env/git-status.txt"
hostname > "$RUN_ROOT/env/compute-hostname.txt"
cp "$PBS_NODEFILE" "$RUN_ROOT/env/pbs-nodefile.txt"
module -t list > "$RUN_ROOT/env/modules.txt" 2>&1
nvidia-smi -L > "$RUN_ROOT/env/nvidia-smi.txt" 2>&1
"$PYTHON" --version > "$RUN_ROOT/env/python.txt" 2>&1
"$PYTHON" -c 'import torch; print(torch.__version__)' > "$RUN_ROOT/env/torch.txt" 2>&1
printf '%q ' "$PYTHON" -m pytest -q tests/stage1 > "$RUN_ROOT/commands.log"
printf '\n' >> "$RUN_ROOT/commands.log"
"$PYTHON" -m pytest -q tests/stage1 \
  > "$RUN_ROOT/stdout/pytest.log" 2> "$RUN_ROOT/stderr/pytest.log"
printf '%q ' "$PYTHON" -m py_compile src/fsbdd/syncer_readiness.py \
  src/fsbdd/syncer_readiness_stress.py >> "$RUN_ROOT/commands.log"
printf '\n' >> "$RUN_ROOT/commands.log"
"$PYTHON" -m py_compile src/fsbdd/syncer_readiness.py \
  src/fsbdd/syncer_readiness_stress.py \
  > "$RUN_ROOT/stdout/py-compile.log" 2> "$RUN_ROOT/stderr/py-compile.log"
sha256sum $(find "$RUN_ROOT" -type f | sort) > "$RUN_ROOT/checksums.sha256"
