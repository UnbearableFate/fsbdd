#!/bin/bash
#PBS -q debug-g
#PBS -l select=4
#PBS -l walltime=00:30:00
#PBS -W group_list=xg24i002
#PBS -N fsbdd-s1-12-profile-a

set -eEuo pipefail
trap 'echo "[ERROR] line=$LINENO command=$BASH_COMMAND" >&2' ERR

: "${PROJECT_ROOT:=/work/xg24i002/x10041/fsbdd-s100-clean}"
: "${MAIN_ROOT:=/work/xg24i002/x10041/fsbdd}"
: "${EVIDENCE_ROOT:=$MAIN_ROOT/runtime_runs/S1-12/formal-l2}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${INITIAL_HOSTNAME:=miyabi-g1}"
: "${MIYABI_SKILL_DIR:=/work/xg24i002/x10041/.codex/skills/miyabi-development}"
: "${MIYABI_SKILL_COMMIT:=c3ddfa47cadfd9132edf939d359b90b28ab5f8ed}"
: "${MODULE_NAME:=nv-hpcx/25.9}"

PYTHON="$MAIN_ROOT/.venv/bin/python"
CONFIG_SOURCE="configs/stage1/s1_12_profile_a_e2e.json"
CONFIG_SHA256="686551db4cc556e0ea923f2c1482e3f0ed489b3e5173efa8b0791a069bf36977"
CONTRACT_SHA256="b37f9221d7d5c9b1c9699f760b3fb727fde9a03d41875ae693086cccc8937067"
MATRIX_SHA256="09b0e000c0e083b97d27c08c9f98e9ae737097ad6fa6d50851d784a6ebe35f98"
ORACLE_SHA256="b46f0da11527e565f2a7872911f11cbad740eef087ec878267a00c433f3e32de"
ESCALATION_SHA256="33521354188a2813f57f69fa90c3787711fd0eb1f1d8dc0e0b87b3b168d2cd65"
RESEARCH_SHA256="2c0db3148110da10ea62f445c189d2d53b405527d8da264b9af9817f5ca9d835"
SPEC_SHA256="1ea71fb6e34fef0d7b5558d8e7999dfdedeb82957f4331afcf6f80279d1f5a7d"
SKILL_REPOSITORY="https://github.com/UnbearableFate/miyabi-development"
REPOSITORY="https://github.com/UnbearableFate/fsbdd.git"
BRANCH="codex/S1-12-profile-a-e2e"
RUN_ID="s1-12-${PBS_JOBID}"
TEST_ROOT="$MAIN_ROOT/runtime_runs/S1-12/shared-${PBS_JOBID}"
MANIFEST_DRAFT="/tmp/s1-12-manifest-${PBS_JOBID}.json"

if [[ ! -x "$PYTHON" ]]; then
  echo "Missing project Python: $PYTHON" >&2
  exit 69
fi
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
module load "$MODULE_NAME"
if [[ "$(git -C "$PROJECT_ROOT" rev-parse HEAD)" != "$EXPECTED_COMMIT" ]]; then
  echo "clean worktree commit mismatch" >&2
  exit 65
fi
if [[ -n "$(git -C "$PROJECT_ROOT" status --porcelain)" ]]; then
  echo "formal worktree is dirty" >&2
  exit 65
fi
if [[ "$(git -C "$MIYABI_SKILL_DIR" rev-parse HEAD)" != "$MIYABI_SKILL_COMMIT" ]]; then
  echo "Miyabi skill commit mismatch" >&2
  exit 65
fi
if [[ "$(sha256sum "$PROJECT_ROOT/$CONFIG_SOURCE" | awk '{print $1}')" != "$CONFIG_SHA256" ]]; then
  echo "Profile A config hash mismatch" >&2
  exit 65
fi
if [[ "$(sha256sum "$PROJECT_ROOT/reports/stage1/S1-12-evidence-contract.json" | awk '{print $1}')" != "$CONTRACT_SHA256" ]]; then
  echo "Profile A evidence contract hash mismatch" >&2
  exit 65
fi
if [[ "$(sha256sum "$PROJECT_ROOT/reports/stage1/S1-12-requirement-matrix.csv" | awk '{print $1}')" != "$MATRIX_SHA256" ]]; then
  echo "Profile A requirement matrix hash mismatch" >&2
  exit 65
fi
if [[ "$(sha256sum "$PROJECT_ROOT/reports/stage1/S1-12-numeric-oracle-contract.json" | awk '{print $1}')" != "$ORACLE_SHA256" ]]; then
  echo "Profile A numeric oracle contract hash mismatch" >&2
  exit 65
fi
if [[ "$(sha256sum "$PROJECT_ROOT/reports/stage1/S1-12-targeted-attempt-escalation.json" | awk '{print $1}')" != "$ESCALATION_SHA256" ]]; then
  echo "Profile A targeted attempt decision hash mismatch" >&2
  exit 65
fi

cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT/src"
export OMP_NUM_THREADS=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1

"$PYTHON" -m fsbdd.cli evidence init "$EVIDENCE_ROOT"
mkdir -p "$EVIDENCE_ROOT"/{analysis,configs,env,runtime/roles,stdout,stderr}
sort -u "$PBS_NODEFILE" > "$EVIDENCE_ROOT/env/compute-hosts.txt"
if [[ "$(wc -l < "$EVIDENCE_ROOT/env/compute-hosts.txt")" -ne 4 ]]; then
  echo "S1-12 requires four distinct compute hosts" >&2
  exit 66
fi
cp "$PBS_NODEFILE" "$EVIDENCE_ROOT/env/pbs-nodefile.txt"
hostname > "$EVIDENCE_ROOT/env/compute-hostname.txt"
git status --porcelain > "$EVIDENCE_ROOT/env/git-status.txt"
git rev-parse HEAD > "$EVIDENCE_ROOT/env/git-commit.txt"
"$PYTHON" --version > "$EVIDENCE_ROOT/env/python.txt" 2>&1
"$PYTHON" -c 'import torch; print(torch.__version__)' \
  > "$EVIDENCE_ROOT/env/torch.txt" 2>&1
mpirun -np 4 --map-by ppr:1:node --hostfile "$PBS_NODEFILE" \
  nvidia-smi -L > "$EVIDENCE_ROOT/env/nvidia-smi-all-ranks.txt" 2>&1
module -t list > "$EVIDENCE_ROOT/env/modules.txt" 2>&1
qstat -f "$PBS_JOBID" > "$EVIDENCE_ROOT/env/qstat.txt"
findmnt -T "$MAIN_ROOT/runtime_runs" > "$EVIDENCE_ROOT/env/findmnt.txt"
QTIME_RAW="$(awk -F' = ' '/^[[:space:]]*qtime =/{print $2}' "$EVIDENCE_ROOT/env/qstat.txt")"
QTIME_UTC="$(date -u -d "$QTIME_RAW JST" '+%Y-%m-%dT%H:%M:%SZ')"
QUEUE="$(awk -F' = ' '/^[[:space:]]*queue =/{print $2}' "$EVIDENCE_ROOT/env/qstat.txt")"
QSTAT_JOB_ID="$(awk -F': ' '/^Job Id:/{print $2}' "$EVIDENCE_ROOT/env/qstat.txt")"
QSTAT_GROUP="$(awk -F' = ' '/^[[:space:]]*group_list =/{print $2}' "$EVIDENCE_ROOT/env/qstat.txt")"
QSTAT_SELECT="$(awk -F' = ' '/^[[:space:]]*Resource_List.select =/{print $2}' "$EVIDENCE_ROOT/env/qstat.txt")"
QSTAT_STATE="$(awk -F' = ' '/^[[:space:]]*job_state =/{print $2}' "$EVIDENCE_ROOT/env/qstat.txt")"
if [[ "$QSTAT_JOB_ID" != "$PBS_JOBID" || "$QUEUE" != "debug-g" || \
      "$QSTAT_GROUP" != "xg24i002" || "$QSTAT_SELECT" != "4" || "$QSTAT_STATE" != "R" ]]; then
  echo "scheduler identity differs from the frozen L2 contract" >&2
  exit 65
fi

cp "$CONFIG_SOURCE" "$EVIDENCE_ROOT/configs/profile-a.json"
cp reports/stage1/S1-12-evidence-contract.json "$EVIDENCE_ROOT/configs/evidence-contract.json"
cp reports/stage1/S1-12-requirement-matrix.csv "$EVIDENCE_ROOT/configs/requirement-matrix.csv"
cp reports/stage1/S1-12-numeric-oracle-contract.json "$EVIDENCE_ROOT/configs/numeric-oracle-contract.json"
cp reports/stage1/S1-12-targeted-attempt-escalation.json "$EVIDENCE_ROOT/configs/targeted-attempt-escalation.json"
"$PYTHON" -m fsbdd.cli requirements \
  plans/FS_DILOCO_CODEX_EXECUTION_PLAN/loops/stage1/S1-12.md \
  reports/stage1/S1-12-requirement-matrix.csv \
  > "$EVIDENCE_ROOT/analysis/requirements.json" \
  2> "$EVIDENCE_ROOT/stderr/requirements.log"

printf '%q ' "$PYTHON" -m pytest -q tests/stage1 > "$EVIDENCE_ROOT/commands.log"
printf '\n' >> "$EVIDENCE_ROOT/commands.log"
"$PYTHON" -m pytest -q tests/stage1 \
  > "$EVIDENCE_ROOT/stdout/pytest.log" 2> "$EVIDENCE_ROOT/stderr/pytest.log"

if [[ -e "$TEST_ROOT" ]]; then
  echo "refusing to reuse Profile A shared root: $TEST_ROOT" >&2
  exit 73
fi
mkdir "$TEST_ROOT"
printf '%q ' mpirun -np 4 --map-by ppr:1:node --hostfile "$PBS_NODEFILE" \
  /usr/bin/env "PYTHONPATH=$PYTHONPATH" "PBS_JOBID=$PBS_JOBID" \
  "PBS_NODEFILE=$PBS_NODEFILE" "OMP_NUM_THREADS=$OMP_NUM_THREADS" \
  "HF_HUB_OFFLINE=$HF_HUB_OFFLINE" "TRANSFORMERS_OFFLINE=$TRANSFORMERS_OFFLINE" \
  "HF_DATASETS_OFFLINE=$HF_DATASETS_OFFLINE" \
  "$PYTHON" -m fsbdd.profile_a_stress role \
  --root "$TEST_ROOT" --result-root "$EVIDENCE_ROOT/runtime/roles" \
  --run-id "$RUN_ID" --config-path "$PROJECT_ROOT/$CONFIG_SOURCE" \
  --config-identity "$CONFIG_SHA256" >> "$EVIDENCE_ROOT/commands.log"
printf '\n' >> "$EVIDENCE_ROOT/commands.log"

mpirun -np 4 --map-by ppr:1:node --hostfile "$PBS_NODEFILE" \
  /usr/bin/env "PYTHONPATH=$PYTHONPATH" "PBS_JOBID=$PBS_JOBID" \
  "PBS_NODEFILE=$PBS_NODEFILE" "OMP_NUM_THREADS=$OMP_NUM_THREADS" \
  "HF_HUB_OFFLINE=$HF_HUB_OFFLINE" "TRANSFORMERS_OFFLINE=$TRANSFORMERS_OFFLINE" \
  "HF_DATASETS_OFFLINE=$HF_DATASETS_OFFLINE" \
  "$PYTHON" -m fsbdd.profile_a_stress role \
  --root "$TEST_ROOT" --result-root "$EVIDENCE_ROOT/runtime/roles" \
  --run-id "$RUN_ID" --config-path "$PROJECT_ROOT/$CONFIG_SOURCE" \
  --config-identity "$CONFIG_SHA256" \
  > "$EVIDENCE_ROOT/stdout/mpirun.log" 2> "$EVIDENCE_ROOT/stderr/mpirun.log"

cp -a "$EVIDENCE_ROOT/runtime/roles/evaluation" "$EVIDENCE_ROOT/evaluation"

"$PYTHON" -m fsbdd.profile_a_stress summarize \
  --result-root "$EVIDENCE_ROOT/runtime/roles" --shared-root "$TEST_ROOT" \
  --config-path "$PROJECT_ROOT/$CONFIG_SOURCE" --config-identity "$CONFIG_SHA256" \
  --output "$EVIDENCE_ROOT/analysis/profile-a-summary.json" \
  > "$EVIDENCE_ROOT/stdout/profile-a-summary.json" \
  2> "$EVIDENCE_ROOT/stderr/profile-a-summary.log"

cp -a "$TEST_ROOT" "$EVIDENCE_ROOT/runtime/shared-state"

"$PYTHON" -m fsbdd.profile_a_stress manifest \
  --repository "$REPOSITORY" --branch "$BRANCH" --commit "$EXPECTED_COMMIT" \
  --run-id "$RUN_ID" --config-sha256 "$CONFIG_SHA256" \
  --research-sha256 "$RESEARCH_SHA256" --spec-sha256 "$SPEC_SHA256" \
  --skill-repository "$SKILL_REPOSITORY" --skill-commit "$MIYABI_SKILL_COMMIT" \
  --initial-hostname "$INITIAL_HOSTNAME" --project-root "$PROJECT_ROOT" \
  --evidence-root "$EVIDENCE_ROOT" --job-id "$PBS_JOBID" --qtime-utc "$QTIME_UTC" \
  --queue "$QUEUE" --group xg24i002 --nodefile "$EVIDENCE_ROOT/env/pbs-nodefile.txt" \
  --modules-file "$EVIDENCE_ROOT/env/modules.txt" \
  --result-root "$EVIDENCE_ROOT/runtime/roles" --output "$MANIFEST_DRAFT" \
  > "$EVIDENCE_ROOT/stdout/manifest.json" 2> "$EVIDENCE_ROOT/stderr/manifest.log"

if find "$EVIDENCE_ROOT/stderr" -type f -size +0c -print -quit | grep -q .; then
  echo "formal package contains non-empty stderr" >&2
  find "$EVIDENCE_ROOT/stderr" -type f -size +0c -print >&2
  exit 70
fi

"$PYTHON" -m fsbdd.cli evidence finalize "$EVIDENCE_ROOT" "$MANIFEST_DRAFT"
"$PYTHON" -m fsbdd.cli evidence validate "$EVIDENCE_ROOT"
rm -f "$MANIFEST_DRAFT"
