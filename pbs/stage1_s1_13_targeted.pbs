#!/bin/bash
#PBS -q debug-g
#PBS -l select=1
#PBS -l walltime=00:30:00
#PBS -W group_list=xg24i002
#PBS -N fsbdd-s1-13-targeted

set -eEuo pipefail
source "${PROJECT_ROOT:-/work/xg24i002/x10041/fsbdd}/pbs/lib/record_experiment_failure.sh"
install_experiment_failure_traps

: "${PROJECT_ROOT:=/work/xg24i002/x10041/fsbdd}"
: "${MAIN_ROOT:=/work/xg24i002/x10041/fsbdd}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${OUTPUT_ROOT:=$PROJECT_ROOT/runtime_runs/S1-13/targeted-${PBS_JOBID}}"

PYTHON="$MAIN_ROOT/.venv/bin/python"

module load nv-hpcx/25.9
if [[ -e "$OUTPUT_ROOT" ]]; then
  echo "refusing to reuse S1-13 targeted regression output" >&2
  exit 73
fi
mkdir "$OUTPUT_ROOT"
cd "$PROJECT_ROOT"
if [[ "$(git rev-parse HEAD)" != "$EXPECTED_COMMIT" ]] || \
   [[ -n "$(git status --porcelain --untracked-files=all -- \
     src pbs tests reports configs plans pyproject.toml uv.lock)" ]]; then
  echo "targeted regression code identity mismatch" >&2
  exit 65
fi
export PYTHONPATH="$PROJECT_ROOT/src"
export OMP_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1

"$PYTHON" -m compileall -q src tests \
  > "$OUTPUT_ROOT/compile.log" 2> "$OUTPUT_ROOT/compile.err"
uvx --offline ruff check src/fsbdd tests \
  > "$OUTPUT_ROOT/ruff.log" 2> "$OUTPUT_ROOT/ruff.err"
uvx --offline pyright --pythonpath "$PYTHON" src/fsbdd \
  > "$OUTPUT_ROOT/pyright.log" 2> "$OUTPUT_ROOT/pyright.err"
for script in pbs/stage1_s1_13_*.pbs pbs/lib/record_experiment_failure.sh; do
  bash -n "$script"
done > "$OUTPUT_ROOT/bash-syntax.log" 2> "$OUTPUT_ROOT/bash-syntax.err"
"$PYTHON" -m pytest -q tests/stage1 \
  > "$OUTPUT_ROOT/pytest.log" 2> "$OUTPUT_ROOT/pytest.err"
hostname > "$OUTPUT_ROOT/hostname.txt"
git rev-parse HEAD > "$OUTPUT_ROOT/commit.txt"
qstat -f "$PBS_JOBID" > "$OUTPUT_ROOT/qstat.txt"
