#!/bin/bash
#PBS -q debug-g
#PBS -l select=1
#PBS -l walltime=00:30:00
#PBS -W group_list=xg24i002
#PBS -N fsbdd-s1-13-targeted

set -eEuo pipefail
source "${PROJECT_ROOT:-/work/xg24i002/x10041/fsbdd}/pbs/lib/record_experiment_failure.sh"
install_experiment_failure_traps

: "${PROJECT_ROOT:=/work/xg24i002/x10041/fsbdd}"
: "${MAIN_ROOT:=/work/xg24i002/x10041/fsbdd}"
: "${OUTPUT_ROOT:=$PROJECT_ROOT/runtime_runs/S1-13/targeted-${PBS_JOBID}}"

PYTHON="$MAIN_ROOT/.venv/bin/python"

module load nv-hpcx/25.9
mkdir -p "$OUTPUT_ROOT"
cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT/src"
export OMP_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1

"$PYTHON" -m pytest -q tests/stage1 \
  > "$OUTPUT_ROOT/pytest.log" 2> "$OUTPUT_ROOT/pytest.err"
"$PYTHON" -m py_compile \
  src/fsbdd/auxiliary/stage1/assets.py src/fsbdd/auxiliary/stage1/close.py src/fsbdd/auxiliary/stage1/gate.py \
  src/fsbdd/auxiliary/stage1/package.py src/fsbdd/auxiliary/stage1/submit.py \
  > "$OUTPUT_ROOT/compile.log" 2> "$OUTPUT_ROOT/compile.err"
hostname > "$OUTPUT_ROOT/hostname.txt"
qstat -f "$PBS_JOBID" > "$OUTPUT_ROOT/qstat.txt"
