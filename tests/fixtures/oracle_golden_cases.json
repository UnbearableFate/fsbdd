{
  "schema_version": 1,
  "accumulation_dtype": "float32",
  "tolerance": 1e-6,
  "pseudo_gradient_cases": [
    {
      "id": "fresh-scalar",
      "current": [5.0],
      "base": [5.0],
      "local": [3.0],
      "base_version": 4,
      "current_version": 4,
      "s_max": 0,
      "expected": [2.0]
    },
    {
      "id": "fresh-vector",
      "current": [4.0, -2.0, 0.5],
      "base": [4.0, -2.0, 0.5],
      "local": [3.0, -1.0, 0.25],
      "base_version": 2,
      "current_version": 2,
      "s_max": 0,
      "expected": [1.0, -1.0, 0.25]
    },
    {
      "id": "stale-s1-counterexample",
      "current": [10.0, 8.0],
      "base": [7.0, 5.0],
      "local": [6.0, 4.0],
      "base_version": 6,
      "current_version": 7,
      "s_max": 1,
      "expected": [1.0, 1.0],
      "forbidden_current_minus_local": [4.0, 4.0]
    }
  ],
  "weight_cases": [
    {
      "id": "mixed-token-staleness",
      "tokens": [100.0, 100.0, 300.0],
      "staleness": [0, 1, 2],
      "lambda_s": 1.0,
      "expected": [0.4, 0.2, 0.4]
    },
    {
      "id": "fresh-no-discount",
      "tokens": [1.0, 3.0],
      "staleness": [0, 0],
      "lambda_s": 2.0,
      "expected": [0.25, 0.75]
    }
  ]
}
